# Zerna Platform - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development  # development, staging, production

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=zerna
POSTGRES_PASSWORD=zerna_dev_password
POSTGRES_DB=zerna
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection string (constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=zerna_redis_password
REDIS_DB=0

# Redis connection string (constructed from above)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Cache TTL settings (in seconds)
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=3600

# =============================================================================
# Temporal Configuration
# =============================================================================
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_PORT=8080
TEMPORAL_TASK_QUEUE=zerna-control-plane

# Temporal connection string
TEMPORAL_ADDRESS=${TEMPORAL_HOST}:${TEMPORAL_PORT}

# Temporal retry policies
ACTIVITY_START_TO_CLOSE_TIMEOUT_SECONDS=300
ACTIVITY_RETRY_INITIAL_INTERVAL_SECONDS=1
ACTIVITY_RETRY_MAXIMUM_INTERVAL_SECONDS=60
ACTIVITY_RETRY_BACKOFF_COEFFICIENT=2.0
ACTIVITY_RETRY_MAXIMUM_ATTEMPTS=5

# Temporal workflow timeouts
WORKFLOW_EXECUTION_TIMEOUT_SECONDS=3600
WORKFLOW_RUN_TIMEOUT_SECONDS=3600

# =============================================================================
# Jaeger Configuration (OpenTelemetry; local observability stack is optional)
# =============================================================================
JAEGER_HOST=localhost
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=4317
JAEGER_COLLECTOR_HTTP_PORT=4318

# OpenTelemetry exporter endpoint
# Leave blank when you are not running ./scripts/setup-dev-env.sh --with-observability.
OTEL_EXPORTER_OTLP_ENDPOINT=http://${JAEGER_HOST}:${JAEGER_COLLECTOR_PORT}
OTEL_SERVICE_NAME=zerna-api

# =============================================================================
# S3 / MinIO Configuration
# =============================================================================
# MinIO API: inside Docker Compose use http://minio:9000 (set automatically for the worker).
# API/web dev on the host: point at the host-mapped port (docker-compose maps container 9000 → host
# MINIO_PORT, default 19000). Set S3_ENDPOINT_URL explicitly if you change MINIO_PORT.
S3_ENDPOINT_URL=http://localhost:19000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# S3 bucket names
S3_DATASETS_BUCKET=zerna-datasets-dev
S3_ARTIFACTS_BUCKET=zerna-artifacts-dev

# MinIO console (host ports; container listens on 9000/9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:8000

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# After 5 wrong passwords, login is blocked for 15 minutes (Redis). Set false for local dev.
AUTH_LOGIN_LOCKOUT_ENABLED=true
# Local visualization: set true to skip sign-in (API uses bootstrap admin when no Bearer token).
AUTH_DISABLED=false
NEXT_PUBLIC_AUTH_DISABLED=false

# =============================================================================
# Authentication & Security
# =============================================================================
# JWT configuration
# Production: use RS256 with a PEM-encoded private key in JWT_SECRET_KEY (multi-line PEM).
# Local dev: HS256 + a long random string is simplest, e.g. openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Password hashing
PASSWORD_HASH_ALGORITHM=argon2id

# Bootstrap admin behavior
# If BOOTSTRAP_ADMIN_EMAIL exists in the database, startup promotes it to admin in the active org.
# Set BOOTSTRAP_ADMIN_PASSWORD to auto-create the account when it does not exist yet.
BOOTSTRAP_ADMIN_EMAIL=admin@zerna.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ORG_NAME=Zerna

# =============================================================================
# Multi-Tenancy & Quotas
# =============================================================================
# Default organization quotas
DEFAULT_STORAGE_QUOTA_GB=1000
DEFAULT_COMPUTE_QUOTA_RUNS=10

# =============================================================================
# Compute Plane Configuration
# =============================================================================
# Nextflow configuration
NEXTFLOW_WORK_DIR=/tmp/nextflow-work
NEXTFLOW_ASSETS_DIR=/tmp/nextflow-assets

# Compute preferences
DEFAULT_COMPUTE_PREFERENCE=GPU_PREFERRED  # CPU_ONLY, GPU_PREFERRED, GPU_REQUIRED

# =============================================================================
# LLM Integration (Optional)
# =============================================================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=30

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TIMEOUT=30

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text

# =============================================================================
# Web Application Configuration
# =============================================================================
# Use the same host/port as API_PORT. apps/web/.env.local overrides for Next dev.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# =============================================================================
# AnnotationAgentV3_0 (annotation_method=annotation_agent_v3)
# =============================================================================
# External pan_prostate_agent is no longer required. This runtime is native to this repo.
# Override Zerna JSON root only if you need a non-default marker knowledge base.

# =============================================================================
# Pipeline worker / Numba (optional)
# =============================================================================
# Clustering uses sklearn kNN + gaussian connectivities to avoid Numba/TBB in neighbors.
# The embed (UMAP) step still uses umap-learn/Numba; if that fails with "Intel TBB is required",
# leave unset or set to workqueue (code and worker.py already default empty/tbb → workqueue).
# NUMBA_THREADING_LAYER=workqueue
# Keep enabled in production when using SoupX, scDblFinder, or DoubletFinder pipeline options.
ZERNA_INSTALL_OPTIONAL_R_BACKENDS=1
# scVI/Torch-backed methods need more than Docker's default 64 MiB /dev/shm.
WORKER_SHM_SIZE=2gb

# =============================================================================
# Development Tools
# =============================================================================
# Enable debug mode
DEBUG=false

# Enable SQL query logging
SQL_ECHO=false

# Enable hot reload
HOT_RELOAD=true
