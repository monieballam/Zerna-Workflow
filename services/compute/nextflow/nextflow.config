/*
 * Zerna Nextflow Configuration
 * Configures executors, containers, and resource profiles for the single-cell pipeline.
 */

manifest {
    name            = 'zerna-single-cell-pipeline'
    author          = 'Zerna Platform'
    description     = 'Single-cell RNA-seq analysis pipeline'
    version         = '1.0.0'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'main.nf'
}

// Default parameters (overridden at runtime by Temporal/RunService)
params {
    // Input/output
    dataset_path        = null
    output_dir          = 's3://zerna-artifacts/runs'
    run_id              = null
    random_seed         = 42

    // Control Plane callback
    control_plane_url   = 'http://localhost:8000'
    control_plane_token = null

    // QC filtering
    qc_min_genes        = 200
    qc_max_genes        = 6000
    qc_min_cells        = 3
    qc_max_mito_pct     = 20.0
    qc_species          = 'auto'
    qc_mito_prefix      = ''

    // Doublet detection
    doublet_expected_rate = 0.05

    // Normalization
    norm_target_sum     = 10000
    norm_scale          = true
    norm_max_value      = 10.0

    // HVG selection
    hvg_n_top_genes     = 2000
    hvg_flavor          = 'seurat_v3'
    hvg_batch_key       = null

    // PCA
    pca_n_components    = 50

    // Batch correction
    batch_correction    = false
    integration_mode    = null       // 'harmony' | 'scvi'; falls back to batch_method
    batch_method        = 'harmony'   // legacy alias when integration_mode is null
    batch_key           = null

    // Clustering
    clustering_method   = 'leiden'    // 'leiden' or 'louvain'
    clustering_resolution = 1.0
    clustering_n_neighbors = 15

    // Embedding
    embedding_method    = 'umap'      // 'umap' or 'tsne'
    umap_n_components   = 2
    umap_min_dist       = 0.5
    tsne_perplexity     = 30.0

    // Annotation
    // Dashboard / Temporal runs use `RunExecutionWorkflow` → `execute_pipeline` (Python in the
    // worker). Those runs take `annotation_method` from the API template + run parameters
    // (default: celltypist). They do NOT read this file.
    //
    // The native AnnotationAgentV3-compatible runtime now lives in `methods/annotation`, so
    // standalone Nextflow runs no longer depend on a sibling `removed` checkout.
    // The default remains `conservative` here because it is cheaper for local / batch smoke runs;
    // pass `-params-file` / API overrides to use celltypist when you want parity with
    // the dashboard default.
    annotation_method   = 'conservative'
    annotation_model    = 'Immune_All_Low.pkl'
    annotation_majority_voting = true
    annotation_cluster_key = null
    annotation_min_prob = 0.0
    annotation_marker_pack_path = null
    annotation_cluster_prior_path = null
    annotation_tissue_context = ''
    annotation_cancer_type = null
    annotation_species = 'human'
    annotation_cluster_marker_top_n = 50
    annotation_min_marker_overlap = 2
    annotation_benchmark_reference_key = null
    knowledge_pack_version = null

    // Differential expression
    de_cluster_key      = 'leiden'
    de_method           = 'wilcoxon'
    de_n_genes          = 0

    // Pathway scoring
    pathway_scoring     = false
    pathway_database    = 'MSigDB'
    pathway_net_path    = null

    // Ligand-receptor analysis
    ligand_receptor     = false
    lr_resource_name    = 'consensus'
    lr_expr_prop        = 0.1
    lr_n_perms          = 100
}

// Process-level defaults
process {
    errorStrategy = 'retry'
    maxRetries    = 2

    // Default resource allocation
    cpus   = 2
    memory = '8 GB'
    time   = '2 h'

    // Capture stdout/stderr for error reporting
    publishDir = [
        path: { "${params.output_dir}/${params.run_id}" },
        mode: 'copy',
        saveAs: { filename -> filename }
    ]

    // Per-process resource overrides
    withLabel: 'cpu_small' {
        cpus   = 2
        memory = '4 GB'
        time   = '1 h'
    }

    withLabel: 'cpu_medium' {
        cpus   = 4
        memory = '16 GB'
        time   = '2 h'
    }

    withLabel: 'cpu_large' {
        cpus   = 8
        memory = '32 GB'
        time   = '4 h'
    }

    withLabel: 'gpu_preferred' {
        cpus          = 4
        memory        = '16 GB'
        time          = '2 h'
        accelerator   = [request: 1, type: 'nvidia-tesla-t4']
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withLabel: 'gpu_required' {
        cpus          = 4
        memory        = '16 GB'
        time          = '4 h'
        accelerator   = [request: 1, type: 'nvidia-tesla-t4']
        errorStrategy = 'terminate'
    }
}

// Executor profiles
profiles {
    // Local development (no containers, uses host Python env)
    local {
        process.executor = 'local'
        docker.enabled   = false
    }

    // Docker-based local execution
    docker {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '--rm'
    }

    // AWS Batch for production
    aws_batch {
        process.executor       = 'awsbatch'
        process.queue          = 'zerna-cpu-queue'
        aws.region             = 'us-east-1'
        aws.batch.cliPath      = '/usr/local/bin/aws'
        docker.enabled         = true

        process {
            withLabel: 'gpu_preferred' {
                queue = 'zerna-gpu-queue'
            }
            withLabel: 'gpu_required' {
                queue = 'zerna-gpu-queue'
            }
        }
    }

    // CI/testing profile (minimal resources, no GPU)
    test {
        process.executor = 'local'
        docker.enabled   = false
        params {
            pca_n_components          = 10
            hvg_n_top_genes           = 500
            clustering_n_neighbors    = 5
            de_n_genes                = 50
            lr_n_perms                = 0
        }
    }
}

// Container registry (override per environment)
params.container_registry = 'ghcr.io/zerna'
params.container_tag      = 'latest'
