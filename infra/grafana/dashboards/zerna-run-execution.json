{
  "title": "Zerna Run Execution",
  "uid": "zerna-run-execution",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "template",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(zerna_run_duration_seconds_bucket, template)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Runs by Status",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(zerna_runs_active) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Run Duration Distribution by Template",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(zerna_run_duration_seconds_bucket{template=~\"$template\"}[5m])) by (le, template))",
          "legendFormat": "p50 {{template}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(zerna_run_duration_seconds_bucket{template=~\"$template\"}[5m])) by (le, template))",
          "legendFormat": "p95 {{template}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(zerna_run_duration_seconds_bucket{template=~\"$template\"}[5m])) by (le, template))",
          "legendFormat": "p99 {{template}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Run Completion Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(zerna_runs_completed_total[10m])) / (sum(rate(zerna_runs_completed_total[10m])) + sum(rate(zerna_runs_failed_total[10m])))",
          "legendFormat": "Completion Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Method Execution Time by Method",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(zerna_method_duration_seconds_bucket[5m])) by (le, method_name))",
          "legendFormat": "p95 {{method_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Artifact Generation Rate and Size",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(zerna_artifact_size_bytes_sum[5m])) by (artifact_type)",
          "legendFormat": "Size Rate - {{artifact_type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(zerna_artifact_size_bytes_count[5m])) by (artifact_type)",
          "legendFormat": "Count Rate - {{artifact_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed Runs with Error Details",
      "type": "table",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(increase(zerna_runs_failed_total[1h])) by (template, error_type)",
          "legendFormat": "{{template}} - {{error_type}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "template": "Pipeline Template",
              "error_type": "Error Type",
              "Value": "Failed Count"
            }
          }
        }
      ]
    }
  ]
}
