{
  "title": "Zerna Platform Overview",
  "uid": "zerna-overview",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "API Latency (p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(zerna_api_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Run Duration (p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(zerna_run_duration_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(zerna_api_errors_total[5m])) by (error_type, endpoint)",
          "legendFormat": "{{error_type}} - {{endpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Artifact Size Distribution",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(zerna_artifact_size_bytes_bucket[5m])) by (le, artifact_type))",
          "legendFormat": "{{artifact_type}}"
        }
      ]
    }
  ]
}
