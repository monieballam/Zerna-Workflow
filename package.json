{
  "name": "zerna-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Zerna - Production-ready, cloud-native single-cell analysis platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "methods/*",
    "workflows/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "ci:local": "bash scripts/run-local-ci.sh quick",
    "ci:local:full": "bash scripts/run-local-ci.sh full",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:js": "eslint --no-error-on-unmatched-pattern \"apps/web/components/**/*.{ts,tsx}\" \"apps/web/lib/**/*.{ts,tsx}\" \"packages/sdk/src/**/*.{ts,tsx}\"",
    "lint:py": "uv run ruff check .",
    "format": "turbo run format",
    "format:js": "prettier --write .",
    "format:py": "uv run ruff format .",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.py": [
      "uv run ruff check --fix",
      "uv run ruff format"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
